{
  "name": "bran-flakes",
  "scripts": {
    "start": "yarn clean && yarn copy-static && yarn watch:all",
    "build": "yarn clean && yarn build:all && yarn copy-static",
    "build:all": "yarn build:popup & yarn build:options",
    "build:popup": "parcel build src/popup.tsx -o popup.js --public-url='/'",
    "build:options": "parcel build src/options.ts -o options.js",
    "watch:all": "yarn watch:popup & yarn watch:options & npm-watch & yarn css-types -w",
    "watch:popup": "parcel watch src/popup.tsx -o popup.js --public-url='/'",
    "watch:options": "parcel watch src/options.ts -o options.js",
    "copy-static": "cp -r static/ dist/",
    "clean": "rm -rf dist",
    "css-types": "tcm src",
    "postinstall": "yarn css-types",
    "precommit": "lint-staged",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "watch": {
    "copy-static": {
      "patterns": [
        "static"
      ],
      "extensions": "*",
      "quiet": false
    }
  },
  "devDependencies": {
    "@ceoimon/typed-css-modules": "^0.0.1",
    "@types/chrome": "^0.0.63",
    "@types/react": "^16.14.19",
    "@types/react-dom": "^16.9.14",
    "husky": "^0.14.3",
    "lint-staged": "^7.3.0",
    "npm-watch": "^0.3.0",
    "parcel-bundler": "^1.12.5",
    "postcss-modules": "^1.5.0",
    "tslint": "^5.20.1",
    "typescript": "^2.9.2",
    "vitest": "^3.2.4",
    "web-ext-types": "^2.3.0",
    "yarn": "^1.22.17"
  },
  "dependencies": {
    "node-html-parser": "^5.0.0",
    "react": "^16.14.0",
    "react-dom": "^16.14.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "tslint",
      "vitest run --reporter=verbose"
    ]
  },
  "version": "0.1.0",
  "private": true
}
